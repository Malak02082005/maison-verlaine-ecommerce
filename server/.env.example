# Copy this file to .env and fill it in

PORT=5001

# MongoDB connection string (e.g. from MongoDB Atlas). The part after the last "/" is the
# database name: use /ecommerce so it doesn't mix with other projects on the same cluster.
MONGO_URI=

# Any long random string, used to sign login tokens
JWT_SECRET=

# Stripe TEST secret key (starts with sk_test_): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Production only: the deployed frontend's address (comma-separate several). Leave empty locally.
CLIENT_URL=
